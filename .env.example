# ============================================================
# ClinicOS / MERUNA — Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى git أبدًا.
# Copy to .env and fill in the values. Never commit .env.
# ============================================================

# ---------- Core / أساسي (مطلوب) ----------
# Postgres connection string (Supabase pooler or direct)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Secret used to sign session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Supabase publishable (anon) key — used for user-scoped requests
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=   # accepted legacy alias

# Supabase secret (service role) key — server only, bypasses RLS
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # accepted legacy alias

# ---------- App ----------
# Public origin of the deployed app (used for CORS + webhook generation)
PUBLIC_APP_URL=https://your-app.vercel.app

# Comma-separated extra CORS origins (optional)
# ALLOWED_ORIGINS=https://staging.your-app.com

# NODE_ENV=development
# LOG_LEVEL=info

# ---------- Platform admin & inbound webhooks ----------
# Protects /api/admin/* — generate with: openssl rand -hex 32
PLATFORM_ADMIN_SECRET=

# Shared secret appended to inbound channel webhooks (n8n → API)
INBOX_INBOUND_SECRET=

# ---------- Outbound dispatcher (n8n fallback) ----------
# n8n webhook that delivers inbox replies when no direct channel client exists
# N8N_INBOX_OUTBOUND_WEBHOOK=
# N8N_INBOX_OUTBOUND_TOKEN=

# ---------- Email (Resend) ----------
# Welcome-kit emails for newly provisioned clinics
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=onboarding@yourdomain.com

# ---------- Billing (Paddle) ----------
# PADDLE_API_KEY=pdl_live_apikey_xxxxxxxx
# PADDLE_CLIENT_TOKEN=live_xxxxxxxx
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxx
# Price IDs (defaults point to the current catalog; override if you rotate)
# PADDLE_PRICE_STARTER_MONTH=
# PADDLE_PRICE_STARTER_YEAR=
# PADDLE_PRICE_GROWTH_MONTH=
# PADDLE_PRICE_GROWTH_YEAR=
# PADDLE_PRICE_PRO_MONTH=
# PADDLE_PRICE_PRO_YEAR=

# ---------- WhatsApp (WasapFlow Bridge) ----------
# WF_PARTNER_KEY=wf_live_xxxxxxxx
# WF_WEBHOOK_SECRET=whsec_xxxxxxxx
# WF_BASE_URL=https://officialapi.wasapflow.com/bridge/v1

# ---------- Local dev only ----------
# PORT=5000                                  # API server port
# API_PROXY_TARGET=http://localhost:5000     # Vite dev proxy target
# BASE_PATH=/                                # Vite base path
